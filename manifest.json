{
  "manifest_version": 3,
  "name": "Étal — studio d'annonces Vinted",
  "version": "2.0.0",
  "description": "L'atelier d'annonces Vinted : photos, textes, score de qualité, marge et publication depuis votre navigateur.",
  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": [
    "*://*.vinted.fr/*",
    "*://*.vinted.be/*",
    "*://*.vinted.de/*",
    "*://*.vinted.at/*",
    "*://*.vinted.es/*",
    "*://*.vinted.it/*",
    "*://*.vinted.nl/*",
    "*://*.vinted.co.uk/*",
    "*://*.vinted.ie/*",
    "*://*.vinted.pt/*",
    "*://*.vinted.pl/*",
    "*://*.vinted.cz/*",
    "*://*.vinted.sk/*",
    "*://*.vinted.hu/*",
    "*://*.vinted.ro/*",
    "*://*.vinted.lt/*",
    "*://*.vinted.se/*",
    "*://*.vinted.fi/*",
    "*://*.vinted.gr/*",
    "*://*.vinted.lu/*",
    "*://*.vinted.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ouvrir Étal",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.vinted.fr/*",
        "*://*.vinted.be/*",
        "*://*.vinted.de/*",
        "*://*.vinted.at/*",
        "*://*.vinted.es/*",
        "*://*.vinted.it/*",
        "*://*.vinted.nl/*",
        "*://*.vinted.co.uk/*",
        "*://*.vinted.ie/*",
        "*://*.vinted.pt/*",
        "*://*.vinted.pl/*",
        "*://*.vinted.cz/*",
        "*://*.vinted.sk/*",
        "*://*.vinted.hu/*",
        "*://*.vinted.ro/*",
        "*://*.vinted.lt/*",
        "*://*.vinted.se/*",
        "*://*.vinted.fi/*",
        "*://*.vinted.gr/*",
        "*://*.vinted.lu/*",
        "*://*.vinted.com/*"
      ],
      "js": ["src/content/bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
